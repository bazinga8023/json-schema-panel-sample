{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/audit-event.json",
  "title": "Audit Event",
  "type": "object",
  "required": ["id", "actor", "action", "occurredAt", "target"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^evt_[A-Za-z0-9]+$"
    },
    "actor": {
      "$ref": "#/$defs/principal"
    },
    "action": {
      "type": "string",
      "enum": ["created", "updated", "deleted", "approved", "rejected", "exported"]
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "target": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          }
        ]
      }
    }
  },
  "$defs": {
    "principal": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["user", "service-account", "system"]
        },
        "id": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
