{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/customer-profile.json",
  "title": "Customer Profile",
  "type": "object",
  "required": ["id", "name", "contacts", "status"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^cus_[A-Za-z0-9]+$"
    },
    "name": {
      "type": "object",
      "required": ["given", "family"],
      "properties": {
        "given": {
          "type": "string",
          "minLength": 1
        },
        "family": {
          "type": "string",
          "minLength": 1
        },
        "preferred": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": ["lead", "active", "suspended", "closed"]
    },
    "contacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/emailContact"
          },
          {
            "$ref": "#/$defs/phoneContact"
          }
        ]
      }
    },
    "addresses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/address"
      }
    },
    "preferences": {
      "type": "object",
      "properties": {
        "language": {
          "type": "string",
          "enum": ["en", "zh-CN", "ja", "fr"]
        },
        "marketingOptIn": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "emailContact": {
      "type": "object",
      "required": ["kind", "email"],
      "properties": {
        "kind": {
          "const": "email"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "verified": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "phoneContact": {
      "type": "object",
      "required": ["kind", "phone"],
      "properties": {
        "kind": {
          "const": "phone"
        },
        "phone": {
          "type": "string",
          "pattern": "^\\+[1-9][0-9]{6,14}$"
        },
        "smsEnabled": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "address": {
      "type": "object",
      "required": ["country", "city", "line1"],
      "properties": {
        "country": {
          "type": "string",
          "minLength": 2,
          "maxLength": 2
        },
        "city": {
          "type": "string"
        },
        "line1": {
          "type": "string"
        },
        "postalCode": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
